# ========================================================
# YouTube AI Monitoring Agent - Environment Template
# ========================================================

# YouTube Data API v3 Key from Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here

# Gmail SMTP Authentication Credentials
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_character_app_password

# Recipient Email Address (where the digest is sent)
MAIL_TO=recipient_email@gmail.com
